# ============================================================
# AI Business OS — environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Security (generate: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Emit Strict-Transport-Security even when the app resolves the request
# scheme as http (typical behind Railway TLS termination with
# TRUSTED_PROXY_MODE=none). Keep false in development/test. A
# TLS-terminated production deployment may set HSTS_ENABLED=true after
# verifying that the public service is HTTPS.
HSTS_ENABLED=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://abos:abos@localhost:5432/abos

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting (Redis-backed; auto-disabled by the test suite) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# --- CORS (JSON array) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Frontend (verification / password-reset action links) ---
# Loaded via app.core.config as FRONTEND_URL. Do not hardcode production
# hostnames in application code.
FRONTEND_URL=http://localhost:5173
#
# Railway production must set:
#   FRONTEND_URL=https://nexus-os-omega-two.vercel.app

# --- AI ---
OPENAI_API_KEY=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
