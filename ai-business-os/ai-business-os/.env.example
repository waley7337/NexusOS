# ============================================================
# AI Business OS — environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Security (generate: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# --- Database ---
DATABASE_URL=postgresql+asyncpg://abos:abos@localhost:5432/abos

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting (Redis-backed; auto-disabled by the test suite) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# TRUSTED PROXY CONFIGURATION
# SAFE DEFAULT: FORWARDED HEADERS ARE NOT TRUSTED.
TRUSTED_PROXY_MODE=none
TRUSTED_PROXY_NETWORKS=[]

# USE STATIC MODE ONLY AFTER VERIFYING THE ACTUAL PROXY OR EDGE
# NETWORKS USED BY THE PRODUCTION DEPLOYMENT.
# STATIC FORMAT EXAMPLE:
# TRUSTED_PROXY_MODE=static
# TRUSTED_PROXY_NETWORKS=["10.0.0.0/8","2001:db8::/32"]
#
# NEVER USE UNIVERSAL NETWORKS SUCH AS 0.0.0.0/0 OR ::/0.
# NEVER ADD UNVERIFIED PROXY, RAILWAY, CLOUDFLARE OR AKAMAI CIDRS.

# --- CORS (JSON array) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Frontend (verification / password-reset action links) ---
# Loaded via app.core.config as FRONTEND_URL. Do not hardcode production
# hostnames in application code.
FRONTEND_URL=http://localhost:5173
#
# Railway production must set:
#   FRONTEND_URL=https://nexus-os-omega-two.vercel.app

# --- AI ---
OPENAI_API_KEY=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
